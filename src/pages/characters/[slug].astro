---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const characters = await getCollection("characters");
  return characters.map((char) => ({
    params: { slug: char.slug },
    props: { char },
  }));
}

const { char } = Astro.props;
const { Content } = await char.render();
---

<BaseLayout title={char.data.name}>
  <div class="mb-8">
    <a
      href="/characters/"
      class="text-parchment-500 hover:text-rum-400 text-sm transition-colors"
      >← Tutti i personaggi</a
    >
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Sidebar -->
    <div class="lg:col-span-1">
      <!-- Placeholder immagine -->
      <div
        class="aspect-[3/4] bg-wood-800 border border-gold-600/35 rounded flex items-center justify-center mb-5 relative overflow-hidden"
      >
        <div
          class="absolute inset-3 border border-gold-600/35 border-dashed rounded flex items-center justify-center"
        >
          <span
            class="text-parchment-500 text-sm font-serif italic text-center px-3"
            >[Ritratto di {char.data.name}]</span
          >
        </div>
      </div>

      <div class="flex items-center gap-2 mb-1">
        <span class="text-gold-500/70 text-xs tracking-widest uppercase">{char.data.nation}</span>
        {char.data.status === 'morto' && (
          <span class="text-xs px-1.5 py-0.5 rounded bg-red-900/40 border border-red-700/40 text-red-400 tracking-wide uppercase font-sans">
            Morto
          </span>
        )}
      </div>
      <h1 class="font-serif text-3xl font-bold text-parchment-200 mb-5">
        {char.data.name}
      </h1>

      {char.data.background && char.data.background.length > 0 && (
        <div class="bg-wood-800 border border-gold-600/30 rounded p-4">
          <h3 class="text-xs uppercase tracking-widest text-gold-500/60 mb-3">
            Background
          </h3>
          <ul class="space-y-2">
            {char.data.background.map((item: string) => (
              <li class="flex items-start gap-2 text-sm text-parchment-300">
                <span class="text-gold-500 mt-0.5 shrink-0">◆</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="bg-wood-800 border border-gold-600/30 rounded p-4 mt-4">
        <h3 class="text-xs uppercase tracking-widest text-gold-500/60 mb-3">
          Vantaggi
        </h3>
        <ul class="space-y-2">
          {
            char.data.skills.map((skill: string) => (
              <li class="flex items-start gap-2 text-sm text-parchment-300">
                <span class="text-gold-500 mt-0.5 shrink-0">◆</span>
                <span>{skill}</span>
              </li>
            ))
          }
        </ul>
      </div>

      {
        (char.data.virtue || char.data.hubris) && (
          <div class="bg-wood-800 border border-gold-600/30 rounded p-4 mt-4">
            <h3 class="text-xs uppercase tracking-widest text-gold-500/60 mb-3">
              Arcana
            </h3>
            <div class="space-y-3">
              {char.data.virtue && (
                <div class="flex items-start gap-2">
                  <span class="text-gold-400 mt-0.5 shrink-0">✦</span>
                  <div>
                    <span class="text-xs uppercase tracking-widest text-gold-500/50">
                      Virtù
                    </span>
                    <p class="text-sm font-serif font-bold text-parchment-200">
                      {char.data.virtue.name}
                    </p>
                  </div>
                </div>
              )}
              {char.data.virtue && char.data.hubris && (
                <div class="border-t border-gold-600/20" />
              )}
              {char.data.hubris && (
                <div class="flex items-start gap-2">
                  <span class="text-rum-400 mt-0.5 shrink-0">✦</span>
                  <div>
                    <span class="text-xs uppercase tracking-widest text-rum-400/50">
                      Hubris
                    </span>
                    <p class="text-sm font-serif font-bold text-parchment-200">
                      {char.data.hubris.name}
                    </p>
                  </div>
                </div>
              )}
            </div>
          </div>
        )
      }

      {char.data.sorcery && (
        <div class="bg-wood-800 border border-gold-600/30 rounded p-4 mt-4">
          <h3 class="text-xs uppercase tracking-widest text-gold-500/60 mb-2">
            Stregoneria
          </h3>
          <div class="flex items-center gap-2">
            <span class="shrink-0 text-violet-400 animate-sorcery-glow">✦</span>
            <p class="text-sm font-serif font-bold text-parchment-200">{char.data.sorcery}</p>
          </div>
        </div>
      )}
    </div>

    <!-- Contenuto principale -->
    <div class="lg:col-span-2">
      <blockquote
        class="font-serif italic text-parchment-400 border-l-4 border-gold-600/60 pl-5 py-2 mb-8 bg-wood-800/50 rounded-r"
      >
        {char.data.concept}
      </blockquote>
      <div class="prose prose-invert prose-gold max-w-none">
        <Content />
      </div>
    </div>
  </div>
</BaseLayout>
