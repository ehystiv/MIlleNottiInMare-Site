---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const sessions = await getCollection('sessions');
  return sessions.map((session) => ({
    params: { slug: session.slug },
    props: { session },
  }));
}

const { session } = Astro.props;
const { Content } = await session.render();
---

<BaseLayout title={session.data.title}>
  <div class="mb-6">
    <a href="/sessions/" class="text-parchment-500 hover:text-rum-400 text-sm transition-colors inline-flex items-center gap-2">
      ← Tutte le sessioni
    </a>
  </div>

  <article class="parchment px-8 py-10 md:px-14 md:py-12">
    <header class="mb-10 pb-8 border-b border-[rgba(101,67,20,0.3)]">

      {/* Breadcrumb narrativo */}
      <div class="flex items-center gap-2 flex-wrap mb-5 text-sm">
        <span class="text-[#7a5a30]">📖</span>
        <span class="text-[#6b4a20] font-serif">
          Libro {(['I','II','III','IV','V'] as const)[session.data.book.number - 1] ?? session.data.book.number}
          {' '}&mdash;{' '}
          <span class="italic">"{session.data.book.title}"</span>
        </span>
        <span class="text-[#8a6e4a]/40 mx-1">›</span>
        {session.data.type === 'storia' ? (
          <span class="px-2 py-0.5 rounded text-xs bg-teal-600/15 border border-teal-600/30 text-teal-700 font-medium tracking-wide uppercase">
            Storia · OneShot
          </span>
        ) : (
          <span class="flex items-center gap-2">
            <span class="text-[#7a5030] font-serif italic">"{session.data.arc}"</span>
            <span class="px-2 py-0.5 rounded text-xs bg-[rgba(139,96,32,0.15)] border border-[rgba(139,96,32,0.3)] text-[#7a4010] font-medium tracking-wide">
              Cap. {session.data.arc_part}/{session.data.arc_total}
            </span>
          </span>
        )}
      </div>

      {/* Badge sessione e data */}
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span class="font-mono text-[#7a4010] text-sm tracking-wider bg-[rgba(139,96,32,0.12)] px-3 py-1 rounded border border-[rgba(139,96,32,0.3)]">
          Sessione #{String(session.data.session_number).padStart(3, '0')}
        </span>
        <span class="text-[#8a6e4a]/50">—</span>
        <span class="text-[#7a5a30] text-sm">
          {session.data.date.toLocaleDateString('it-IT', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}
        </span>
      </div>

      <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#1e1208] mb-4 leading-tight">
        {session.data.title}
      </h1>
      <p class="text-[#5a3e1e] italic text-lg border-l-4 border-[rgba(139,96,32,0.5)] pl-4 font-serif">
        {session.data.summary}
      </p>
    </header>

    <div class="prose prose-parchment max-w-none">
      <Content />
    </div>

    {session.data.player_journal && session.data.player_journal.length > 0 && (
      <section class="mt-12 pt-8 border-t border-[rgba(101,67,20,0.3)]">
        <h2 class="font-serif text-2xl font-bold text-[#1e1208] mb-6 flex items-center gap-3">
          <span>📜</span> Diari di Bordo
        </h2>
        <div class="space-y-6">
          {session.data.player_journal.map((entry) => (
            <div class="bg-[rgba(101,67,20,0.08)] border border-[rgba(139,96,32,0.3)] rounded p-5">
              <p class="font-serif italic text-[#4a3018] leading-relaxed mb-3">"{entry.text}"</p>
              <p class="text-[#8b6020] text-sm text-right">— {entry.author}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
