---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const loreEntries = await getCollection('lore');
const sorted = loreEntries.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const sections = [
  { key: 'geografia', label: 'Geografia', icon: '🗺️' },
  { key: 'storia', label: 'Storia', icon: '📜' },
  { key: 'magia', label: 'Magia', icon: '✦' },
  { key: 'altro', label: 'Usi & Costumi', icon: '⚓' },
];
---

<BaseLayout title="Lore & World-building">
  <div class="mb-10">
    <div class="text-rum-500/70 text-xs tracking-widest uppercase mb-2">Il mondo</div>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-parchment-200">Lore & World-building</h1>
    <div class="flex items-center gap-4 mt-4">
      <div class="w-24 h-px bg-gold-600/50"></div>
      <span class="text-gold-600/50 text-sm">✦</span>
    </div>
  </div>

  <!-- Nav ancore -->
  <nav class="flex flex-wrap gap-2 mb-12 p-4 bg-wood-800 border border-gold-600/30 rounded">
    {sections.map((s) => (
      <a
        href={`#${s.key}`}
        class="flex items-center gap-2 px-4 py-2 text-sm text-parchment-400 hover:text-rum-300 hover:bg-rum-500/10 rounded border border-transparent hover:border-gold-600/30 transition-all"
      >
        <span>{s.icon}</span>
        <span>{s.label}</span>
      </a>
    ))}
  </nav>

  {sections.map((section) => {
    const entries = sorted.filter((e) => e.data.section === section.key);
    return (
      <section id={section.key} class="mb-16 scroll-mt-24">
        <div class="flex items-center gap-4 mb-8">
          <span class="text-2xl">{section.icon}</span>
          <h2 class="font-serif text-3xl font-bold text-parchment-200">{section.label}</h2>
          <div class="flex-1 h-px bg-gold-600/25"></div>
        </div>
        {entries.map(async (entry) => {
          const { Content } = await entry.render();
          return (
            <div class="prose prose-invert prose-gold max-w-none mb-8 bg-wood-800/30 border border-gold-600/20 rounded p-6">
              <Content />
            </div>
          );
        })}
      </section>
    );
  })}
</BaseLayout>
